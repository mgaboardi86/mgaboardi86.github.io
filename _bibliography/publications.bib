journal = {ACS Applied Bio Materials},
keywords = {antimicrobial surfaces,controlled release,fatty acids,medical devices,stimuli-responsive materials},
mendeley-groups = {Mat__FULLERENES/Hydrogen Storage (exp),Mat__CLUSTERS/transition metals,Tech__SPECTROSCOPY/INS,Mat__batteries/graphene,Mat__oxides,Mat__NanoParticles,*FIS07_ApplPhys,Mat__batteries/prussian blue,**MPC**/PAH/Corannulene (C20H10),**MPC**/Clathrates-ZIF-MOF,Mat__GRAFENI/H-storage (exp),Mat__YAG & Co},
