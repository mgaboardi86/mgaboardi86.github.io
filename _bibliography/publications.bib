mendeley-groups = {Mat__FULLERENES},
month = {aug},
number = {34},
pages = {19715--19721},
title = {{In Situ Neutron Powder Diffraction of Li6C60 for Hydrogen Storage}},
url = {http://pubs.acs.org/doi/10.1021/acs.jpcc.5b06711},
volume = {119},
year = {2015}
}
