@article{Aramini2013a,
abstract = {We report an innovative synthetic strategy based on the solid state reaction of fullerene C60 with lithium-transition metals alloys (platinum and palladium), which provides transition metal-decorated lithium intercalated fullerides, with improved hydrogen storage properties. Compounds with Li6Pt0.11C60 and Li6Pd 0.07C60 stoichiometry were obtained and investigated with manometric/calorimetric techniques which showed an 18% increase of the final H2 absorbed amount with respect to pure Li6C60 (5.9 wt% H2) and an improved absorption process kinetic. The absorption mechanism was investigated with X-rays diffraction which allowed to identify the formation of the hydrofullerides. Scanning Electron Microscopy was applied to gain information on transition metal distribution and detected the presence of platinum and palladium aggregates which are shown to perform a surface catalytic activity towards hydrogen molecule dissociation process. {\textcopyright} 2013, Hydrogen Energy Publications, LLC. Published by Elsevier Ltd. All rights.},
