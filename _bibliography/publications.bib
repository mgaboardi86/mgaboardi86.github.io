year = {2024}
}
@article{Monteverde2024,
abstract = {High-entropy ceramics have sparked renewed interest in compositionally complex ceramics since the first introduction in 2015. The kaleidoscopic array of compositions and structures harnessed by this idea has unlocked an unprecedented opportunity to tailor materials for specific applications, including catalysis, thermal barriers, and electrochemical energy storage. Within the family of oxides, a competition exists between rock-salt and spinel structures. The rock-salt structure is highly symmetrical, consisting of a single cation sublattice, while the spinel structure offers more flexibility to accommodate various cations in two distinct sublattices. Herein, we aimed at stabilizing and expanding the thermal stability range of the spinel-structured oxide, successfully synthesizing novel, single-phase, compositionally complex materials by capitalizing on entropy stabilization, all while avoiding the ubiquitous use of nickel and chrome, notorious for their negative environmental impact. The right combination of cations resulted in the synthesis of a seven-metal oxide that is thermally stable up to the remarkable temperature of 1473 K.},
author = {Monteverde, F. and Gaboardi, M.},
doi = {10.1016/j.jeurceramsoc.2024.05.028},
file = {:C\:/Users/Mattia/OneDrive - Universita' degli Studi di Roma Tor Vergata/_WORK/ARTICOLI//Monteverde, Gaboardi_Journal of the European Ceramic Society_2024.pdf:pdf;:C\:/Users/Mattia/OneDrive - Universita' degli Studi di Roma Tor Vergata/_WORK/ARTICOLI//Monteverde, Gaboardi_Journal of the European Ceramic Society_2024.pdf:pdf},
issn = {1873619X},
journal = {Journal of the European Ceramic Society},
keywords = {Compositionally complex oxide,Entropy,Rietveld refinement,Spinel,Synch,Synchrotron radiation XRPD},
mendeley-groups = {Mat__High Entropy/_OXIDES_},
month = {oct},
number = {13},
pages = {7704--7715},
publisher = {Elsevier Ltd},
title = {{Entropy-driven expansion of the thermodynamic stability of compositionally complex spinel oxides}},
url = {https://doi.org/10.1016/j.jeurceramsoc.2024.05.028 https://linkinghub.elsevier.com/retrieve/pii/S0955221924004473},
volume = {44},
year = {2024}
}
