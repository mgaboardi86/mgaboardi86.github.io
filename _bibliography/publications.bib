file = {:C\:/Users/Mattia/OneDrive - Universita' degli Studi di Roma Tor Vergata/_WORK/ARTICOLI/Pan{\v{z}}i{\'{c}} et al._Ceramics International_2023.pdf:pdf},
issn = {02728842},
journal = {Ceramics International},
keywords = {Absorber/ETL interface,FIB-STEM,In-situ structural degradation study,Nanostructured electron transfer layers,Quadruple cation PSC absorber,Synchrotron radiation GID},
mendeley-groups = {Mat__oxides,Mat__NanoParticles},
month = {jul},
number = {14},
pages = {24475--24486},
title = {{In-situ structural degradation study of quadruple-cation perovskite solar cells with nanostructured charge transfer layer}},
url = {https://linkinghub.elsevier.com/retrieve/pii/S0272884222046533},
volume = {49},
